{
  "vim_mode": false,
  "buffer_font_features": {
    "calt": false
  },
  "terminal": {
    "font_size": 16.0
  },
  "agent": {
    "default_model": {
      "enable_thinking": true,
      "provider": "copilot_chat",
      "effort": "high",
      "model": "claude-opus-5.5"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "cli_default_open_behavior": "existing_window",
  "theme": {
    "mode": "system",
    "light": "Gruvbox Dark",
    "dark": "Gruvbox Dark"
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "agent_servers": {
    "github-copilot-cli": {
      "favorite_config_option_values": {
        "model": [
          "auto"
        ],
        "mode": [
          "https://agentclientprotocol.com/protocol/session-modes#agent"
        ]
      },
      "default_config_options": {
        "model": "auto",
        "agent": "hackimator",
        "mode": "https://agentclientprotocol.com/protocol/session-modes#agent"
      },
      "type": "registry"
    }
  },
  "context_servers": {
    "aws-mcp": {
      "enabled": true,
      "command": "/Users/plwagner/.local/bin/uvx",
      "args": [
        "--python",
        "3.12",
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "INSTALL_SOURCE=aws-cli"
      ],
      "env": {
        "AWS_MCP_PROXY_PROFILES": "sandbox nuglif_dev nuglif_main shared_services security collection lapresse_bi redaction app_mobile_prod lpp_prod recovery salesforce salesforce_admin main lpinfra lpbackup lpvault"
      }
    },
    "CircleCI": {
      "enabled": false,
      "remote": false,
      "command": "/opt/homebrew/bin/circleci",
      "args": [
        "mcp",
        "start"
      ]
    },
    "atlassian": {
      "enabled": true,
      "url": "https://mcp.atlassian.com/v1/mcp/authv2"
    }
  }
}
